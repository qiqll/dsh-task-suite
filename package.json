{
  "name": "dsh-task-suite",
  "version": "1.1.0",
  "type": "module",
  "description": "Task pool, scheduler, background worker, machine acceptance, and a Web dashboard for DeepSeek Harness.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "skills/*.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "task-management",
    "task-queue",
    "subagent",
    "workflow",
    "automation",
    "orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiqll/dsh-task-suite.git"
  },
  "homepage": "https://github.com/qiqll/dsh-task-suite#readme",
  "bugs": {
    "url": "https://github.com/qiqll/dsh-task-suite/issues"
  },
  "license": "MIT",
  "author": "qiqll",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node selftest.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-modules",
        "dsh-better-sidebar"
      ]
    },
    "manifestVersion": 1
  }
}
