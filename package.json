{
  "name": "dsh-task-suite",
  "version": "1.1.2",
  "type": "module",
  "description": "Task pool, scheduler, background worker, machine acceptance, and a Web dashboard for DeepSeek Harness.",
  "main": "index.js",
  "bin": {
    "dsh-task": "bin/dsh-task"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "bin/*",
    "lib/*.js",
    "skills/*.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "task-management",
    "task-queue",
    "subagent",
    "workflow",
    "automation",
    "orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiqll/dsh-task-suite.git"
  },
  "homepage": "https://github.com/qiqll/dsh-task-suite#readme",
  "bugs": {
    "url": "https://github.com/qiqll/dsh-task-suite/issues"
  },
  "license": "MIT",
  "author": "qiqll",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node selftest.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-modules"
      ]
    },
    "manifestVersion": 1
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "unknown"
    },
    "permissions": [
      "filesystem:workspace",
      "process:spawn",
      "git:read-write"
    ],
    "compatibility": {
      "dshVersions": [
        "0.2.1-rc.5"
      ]
    },
    "capability": {
      "id": "task_status",
      "kind": "tool",
      "invocation": "在任意会话调用 task_status 工具（空任务池）",
      "expected": "返回任务池全局视图：0 条任务、无待决策/阻塞，并给出下一步建议"
    },
    "evidence": {
      "install": null,
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  }
}
